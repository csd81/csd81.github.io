---
const sections = [
  { slug: '00-preliminaries',        label: '§0 Preliminaries' },
  { slug: '01-fixed-point',          label: '§2.1 FPI' },
  { slug: '02-stopping-criteria',    label: '§2.2 Stopping' },
  { slug: '03-bisection',            label: '§2.3 Bisection' },
  { slug: '04-false-position',       label: '§2.4 False Position' },
  { slug: '05-newton',               label: '§2.5 Newton' },
  { slug: '06-secant',               label: '§2.6 Secant' },
  { slug: '07-order-of-convergence', label: '§2.7 Order' },
  { slug: '08-multivariable-calculus', label: '§2.8 Multivariable' },
  { slug: '09-norms',                label: '§2.9 Norms' },
  { slug: '10-fpi-nd',               label: '§2.10 FPI in n-d' },
  { slug: '11-newton-nd',            label: '§2.11 Newton n-d' },
  { slug: '12-broyden',              label: '§2.12 Broyden' },
]
const path = Astro.url.pathname
---

<header class="sticky top-0 z-30 bg-white/85 dark:bg-ink-950/85 backdrop-blur border-b border-ink-200 dark:border-ink-800">
  <div class="prose-numa flex items-center gap-4 py-3 text-sm">
    <a href="/" class="font-semibold text-ink-900 dark:text-ink-100 no-underline whitespace-nowrap">
      Numerical&nbsp;Analysis · Ch.&nbsp;2
    </a>
    <details class="relative ml-auto group">
      <summary class="cursor-pointer list-none rounded px-2 py-1 hover:bg-ink-100 dark:hover:bg-ink-800 select-none">
        Sections ▾
      </summary>
      <nav class="absolute right-0 mt-2 w-72 max-h-[80vh] overflow-y-auto rounded-md border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 shadow-lg p-1">
        {sections.map((s) => (
          <a
            href={`/chapter/${s.slug}`}
            class:list={[
              'block px-3 py-1.5 rounded text-ink-800 dark:text-ink-200 no-underline hover:bg-accent-soft dark:hover:bg-ink-800',
              path === `/chapter/${s.slug}` ? 'font-semibold text-accent' : '',
            ]}
          >
            {s.label}
          </a>
        ))}
        <div class="border-t border-ink-200 dark:border-ink-800 my-1"></div>
        <a href="/playground" class="block px-3 py-1.5 rounded no-underline hover:bg-accent-soft dark:hover:bg-ink-800">
          Playground
        </a>
        <a href="/glossary" class="block px-3 py-1.5 rounded no-underline hover:bg-accent-soft dark:hover:bg-ink-800">
          Theorem index
        </a>
      </nav>
    </details>
    <button
      type="button"
      data-toggle-theme
      aria-label="Toggle theme"
      class="rounded px-2 py-1 hover:bg-ink-100 dark:hover:bg-ink-800"
    >
      <span class="dark:hidden">🌙</span>
      <span class="hidden dark:inline">☀️</span>
    </button>
  </div>
</header>
