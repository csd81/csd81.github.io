---
import 'katex/dist/katex.min.css'
import '~/styles/global.css'
import Nav from './Nav.astro'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Interactive Chapter 2 — Nonlinear Algebraic Equations and Systems' } = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  </head>
  <body class="min-h-screen">
    <Nav />
    <main class="prose-numa py-10">
      <slot />
    </main>
    <footer class="prose-numa pb-12 pt-8 text-sm text-ink-500 dark:text-ink-400 border-t border-ink-200 dark:border-ink-800 mt-16">
      <p>
        Source material: F. Hartung, <em>Numerical Analysis — Chapter 2: Nonlinear Algebraic Equations and Systems</em>,
        University of Pannonia (2025). Interactive site built with Astro, React, Mafs, KaTeX, and math.js.
      </p>
    </footer>

    <script>
      // Minimal dark-mode toggle wired by Nav.astro via [data-toggle-theme]
      const apply = () => {
        const t = localStorage.getItem('theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        document.documentElement.classList.toggle('dark', t === 'dark')
      }
      apply()
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement | null)?.closest('[data-toggle-theme]')
        if (!target) return
        const cur = document.documentElement.classList.contains('dark') ? 'dark' : 'light'
        localStorage.setItem('theme', cur === 'dark' ? 'light' : 'dark')
        apply()
      })
    </script>
  </body>
</html>
