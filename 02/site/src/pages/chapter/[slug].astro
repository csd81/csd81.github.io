---
import { getCollection, type CollectionEntry } from 'astro:content'
import Layout from '~/components/Layout.astro'

export async function getStaticPaths() {
  const entries = await getCollection('chapter')
  const sorted = entries.sort((a, b) => a.data.order - b.data.order)
  return sorted.map((entry, i) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prev: sorted[i - 1],
      next: sorted[i + 1],
    },
  }))
}

interface Props {
  entry: CollectionEntry<'chapter'>
  prev?: CollectionEntry<'chapter'>
  next?: CollectionEntry<'chapter'>
}

const { entry, prev, next } = Astro.props
const { Content } = await entry.render()
---

<Layout title={`${entry.data.title} — Chapter 2`} description={entry.data.summary}>
  <article>
    <Content />
  </article>

  <nav class="mt-12 grid grid-cols-2 gap-4 text-sm">
    <div>
      {prev && (
        <a href={`/chapter/${prev.slug}`} class="block rounded-md border border-ink-200 dark:border-ink-800 p-3 hover:border-accent">
          <div class="text-ink-500 dark:text-ink-400 text-xs uppercase">← Previous</div>
          <div class="font-medium">{prev.data.title}</div>
        </a>
      )}
    </div>
    <div class="text-right">
      {next && (
        <a href={`/chapter/${next.slug}`} class="block rounded-md border border-ink-200 dark:border-ink-800 p-3 hover:border-accent">
          <div class="text-ink-500 dark:text-ink-400 text-xs uppercase">Next →</div>
          <div class="font-medium">{next.data.title}</div>
        </a>
      )}
    </div>
  </nav>
</Layout>
