---
import { getCollection } from 'astro:content'
import Layout from '~/components/Layout.astro'

const entries = (await getCollection('chapter')).sort((a, b) => a.data.order - b.data.order)

const items: Array<{
  number: string
  title?: string
  sectionSlug: string
  sectionTitle: string
}> = []
for (const e of entries) {
  for (const t of e.data.theorems ?? []) {
    items.push({ number: t.number, title: t.title, sectionSlug: e.slug, sectionTitle: e.data.title })
  }
}
items.sort((a, b) => {
  const [a1, a2] = a.number.split('.').map(Number)
  const [b1, b2] = b.number.split('.').map(Number)
  return a1 - b1 || a2 - b2
})
---

<Layout title="Theorem index — Chapter 2">
  <h1>Theorem index</h1>
  <p>
    Every theorem named in the chapter's MDX frontmatter, linked back to the section that introduces it.
  </p>

  <table>
    <thead>
      <tr><th>№</th><th>Title</th><th>Section</th></tr>
    </thead>
    <tbody>
      {items.map((t) => (
        <tr>
          <td class="font-mono whitespace-nowrap">Thm {t.number}</td>
          <td>{t.title ?? '—'}</td>
          <td><a href={`/chapter/${t.sectionSlug}`}>{t.sectionTitle}</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</Layout>
