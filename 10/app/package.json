{
  "name": "ode-numerics-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual interactive educational web app for numerical solution of ODEs (Euler, Taylor, Runge-Kutta).",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mathjs": "^12.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "katex": "^0.16.10",
    "plotly.js-dist-min": "^2.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.23.1",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "vite": "^5.2.11"
  }
}
